{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hali concept show --json",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "concept": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "alt_labels": {"type": "array", "items": {"type": "string"}},
        "broader": {"type": "array", "items": {"type": "string"}},
        "narrower": {"type": "array", "items": {"type": "string"}},
        "tagged": {"type": "integer", "minimum": 0}
      },
      "required": ["id", "label", "alt_labels", "broader", "narrower", "tagged"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "concept"],
  "additionalProperties": false
}
