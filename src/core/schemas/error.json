{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hali error envelope (stderr under --json)",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "error": {
      "type": "object",
      "properties": {
        "rule": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"},
        "message": {"type": "string"},
        "details": {},
        "suggested_fix": {"type": ["string", "null"]},
        "suggested_command": {"type": ["string", "null"]}
      },
      "required": ["rule", "message", "details", "suggested_fix", "suggested_command"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"rule": {"const": "SHACL_VIOLATION"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}},
                  "total": {"type": "integer", "minimum": 0},
                  "truncated": {"type": "boolean"}
                },
                "required": ["violations", "total", "truncated"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "CONFIRMATION_REQUIRED"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {"command": {"type": "string"}, "declined": {"type": "boolean"}},
                "required": ["command", "declined"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "SHAPES_INVALID"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {"file": {"type": "string"}},
                "required": ["file"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "LABEL_TAKEN"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "label": {"type": "string"},
                  "language": {"type": "string"},
                  "concept": {"type": "string"}
                },
                "required": ["label", "language", "concept"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "NOT_A_REGULAR_FILE"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "path": {"type": "string"},
                  "kind": {"enum": ["missing", "directory", "other"]}
                },
                "required": ["path", "kind"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "NON_UTF8_PATH"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "FILE_UNREADABLE"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "UNKNOWN_RESOURCE"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {"ref": {"type": "string"}},
                "required": ["ref"]
              }
            }
          }
        },
        {
          "if": {"properties": {"rule": {"const": "UNKNOWN_CONCEPT"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "concept": {"type": "string"},
                  "suggestions": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {"type": "string"},
                        "label": {"type": "string"}
                      },
                      "required": ["id", "label"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["concept", "suggestions"]
              }
            }
          }
        }
      ]
    }
  },
  "required": ["schema_version", "error"],
  "additionalProperties": false
}
