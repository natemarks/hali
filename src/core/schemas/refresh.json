{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hali refresh --json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "refreshed": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "missing": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "unchanged": {"type": "integer", "minimum": 0}
      },
      "required": ["schema_version", "refreshed", "missing", "unchanged"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "refreshed": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "missing": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "unchanged": {"type": "integer", "minimum": 0},
        "dry_run": {"const": true},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      },
      "required": ["schema_version", "refreshed", "missing", "unchanged", "dry_run", "changes"],
      "additionalProperties": false
    }
  ]
}
