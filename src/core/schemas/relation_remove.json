{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hali relation remove --json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "relation_kind": {"$ref": "#/$defs/relation_kind"}
      },
      "required": ["schema_version", "relation_kind"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "relation_kind": {"$ref": "#/$defs/relation_kind"},
        "dry_run": {"const": true},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      },
      "required": ["schema_version", "relation_kind", "dry_run", "changes"],
      "additionalProperties": false
    }
  ]
}
