@prefix hali: <https://w3id.org/hali#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

hali:topics a skos:ConceptScheme .
hali:ml a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "machine learning"@en .
hali:ml2 a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel " Machine  Learning"@en .
hali:nn a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "neural networks"@en .
hali:dl a skos:Concept ;
	skos:altLabel "Neural Networks"@en ;
	skos:inScheme hali:topics ;
	skos:prefLabel "deep learning"@en .
