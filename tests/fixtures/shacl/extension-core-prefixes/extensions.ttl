@prefix hali: <https://w3id.org/hali#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/s#> .

hali:LabelUniqueConstraint sh:prefixes ex:p .
ex:p sh:declare [ sh:prefix "zz" ; sh:namespace "http://example.org/zz#"^^xsd:anyURI ] .
ex:p sh:message "SECRET-CANARY-4242"@en .
