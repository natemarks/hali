@prefix hali: <https://w3id.org/hali#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

hali:topics a skos:ConceptScheme .
hali:ml a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "machine learning"@en .
hali:ml2 a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "Machine  Learning"@en .
hali:nolabel a skos:Concept ;
	skos:inScheme hali:topics .
hali:orphan a skos:Concept ;
	skos:prefLabel "orphan"@en .
hali:twolabels a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "two"@en , "deux"@en .
