@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hali: <https://w3id.org/hali#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# A blank-node owl:ObjectProperty next to a hali: relation kind with no parent: the blank node
# is skipped and hali:orphan is still reported.
[] a owl:ObjectProperty ;
    owl:inverseOf dcterms:isPartOf .
hali:orphan a owl:ObjectProperty .
