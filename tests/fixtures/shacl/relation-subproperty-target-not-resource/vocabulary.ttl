@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hali: <https://w3id.org/hali#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# annotates is a custom kind under a standard one; summarises is a custom kind under annotates.
hali:annotates a owl:ObjectProperty ; rdfs:subPropertyOf dcterms:references .
hali:summarises a owl:ObjectProperty ; rdfs:subPropertyOf hali:annotates .
