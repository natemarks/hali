@prefix hali: <https://w3id.org/hali#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

hali:topics a skos:ConceptScheme .
hali:chat a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "chat"@en .
hali:chat-fr a skos:Concept ;
	skos:inScheme hali:topics ;
	skos:prefLabel "chat"@fr .
